<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">
    
    <display-name>Leave Management System</display-name>
    
    <!-- Servlet Mappings -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.company.lms.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.company.lms.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <!-- Audit Logs -->
<servlet>
    <servlet-name>AuditLogsServlet</servlet-name>
    <servlet-class>com.company.lms.controller.AuditLogsServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>AuditLogsServlet</servlet-name>
    <url-pattern>/audit/logs</url-pattern>
</servlet-mapping>

<!-- Employee Leave Requests -->
<servlet>
    <servlet-name>EmployeeLeaveRequestServlet</servlet-name>
    <servlet-class>com.company.lms.controller.EmployeeLeaveRequestServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>EmployeeLeaveRequestServlet</servlet-name>
    <url-pattern>/request/employee-requests</url-pattern>
</servlet-mapping>
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.company.lms.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.company.lms.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CreateLeaveRequestServlet</servlet-name>
        <servlet-class>com.company.lms.controller.CreateLeaveRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateLeaveRequestServlet</servlet-name>
        <url-pattern>/request/create</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ListLeaveRequestServlet</servlet-name>
        <servlet-class>com.company.lms.controller.ListLeaveRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListLeaveRequestServlet</servlet-name>
        <url-pattern>/request/list</url-pattern>
    </servlet-mapping>
    
    <servlet>
    <servlet-name>ExportServlet</servlet-name>
    <servlet-class>com.company.lms.controller.ExportServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>ExportServlet</servlet-name>
    <url-pattern>/export</url-pattern>
</servlet-mapping>
    
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.company.lms.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ProfileEditServlet</servlet-name>
        <servlet-class>com.company.lms.controller.ProfileEditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileEditServlet</servlet-name>
        <url-pattern>/profile/edit</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>ProfileUpdateServlet</servlet-name>
        <servlet-class>com.company.lms.controller.ProfileUpdateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileUpdateServlet</servlet-name>
        <url-pattern>/profile/update</url-pattern>
    </servlet-mapping>
    
    <servlet>
    <servlet-name>DetailLeaveRequestServlet</servlet-name>
    <servlet-class>com.company.lms.controller.DetailLeaveRequestServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>DetailLeaveRequestServlet</servlet-name>
    <url-pattern>/request/detail</url-pattern>
</servlet-mapping>
    
    <servlet>
        <servlet-name>AgendaServlet</servlet-name>
        <servlet-class>com.company.lms.controller.AgendaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AgendaServlet</servlet-name>
        <url-pattern>/agenda</url-pattern>
    </servlet-mapping>
    
    <!-- Filters -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.company.lms.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.company.lms.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
    
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>
</web-app>